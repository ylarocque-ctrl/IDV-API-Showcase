{
  "appTitle": "IDV API Showcase",
  "appSubtitle": "Upload documents with metadata — see the exact request as you build it",

  "_fieldTypeLegend": "Field keys are capitalized everywhere (templates and presets alike). 'Type' values: 1 = Text, 2 = Numerical, 3 = Date (set 'DateFormat'), 4 = Dropdown (set 'Options'). Add optional 'Mandatory': true to require a value before sending (defaults to false). For type 4 only, add optional 'Multiple': true to allow selecting several options (sent as a comma-separated Value). Template fields/groups use 'Name'/'Fields'; presets additionally carry 'Value' (only 'Name'/'Value' enter the jreq payload).",

  "_searchFieldNote": "Search (Advanced) > Metadata (searchType 2) reuses these same templates. To make a template's fields searchable, add the backend 'FLDID' (number) to each field and 'GRPID' (number) to each group. The field's existing 'Type' doubles as the search FldType (1=Text/FldValue, 2=Number/min-max, 3=Date/min-max, 4=Dropdown/FldValue). Any field missing 'FLDID' still renders, but with an editable ID box so a demoer can type the real FLDID at runtime. All current templates (2, 3, 4, 6, 7, 8) are populated from the live Get Fields endpoint; re-run Get Fields for a template and update these IDs if its definition changes.",

  "environments": [
    {
      "name": "Presales Demo Instance",
      "baseUrl": "https://quad-eu-fm.azurewebsites.net"
    }
  ],

  "apiKey": "PASTE_DEMO_KEY_AT_RUNTIME",

  "_tabsNote": "Controls which endpoint tabs are shown when the app loads. 'endpoint' must match a tab's data-endpoint in index.html. 'visible': true shows the tab on load, false hides it (it can still be re-enabled at runtime via the 'Tabs' picker beside the instance selector). Any tab in index.html that is missing here defaults to visible.",
  "tabs": [
    { "endpoint": "upload",    "label": "File Upload",        "visible": true },
    { "endpoint": "metadata",  "label": "Add/Modify Metadata", "visible": true },
    { "endpoint": "list",      "label": "File Listing",       "visible": true },
    { "endpoint": "fields",    "label": "Get Fields",         "visible": true },
    { "endpoint": "download",  "label": "File Download",      "visible": true },
    { "endpoint": "search",    "label": "Search (Basic)",     "visible": true },
    { "endpoint": "searchadv", "label": "Search (Advanced)",  "visible": true }
  ],

  "_uploadFolderNote": "'defaults.currentFldrID' is the folder pre-selected on the File Upload tab at load; it must match an 'id' in 'folders' or the first folder in that list is used instead. Selecting a preset no longer changes the folder — presets supply metadata values only, and the folder stays wherever the demoer put it. The 'currentFldrID' still present on each preset is therefore no longer read; the value sent in the request always comes from the folder picker.",

  "uploadEndpoint": {
    "method": "POST",
    "path": "/v1/api/upload",
    "fileFieldName": "file",
    "jsonFieldName": "jreq",
    "defaults": { "currentFldrID": 3 }
  },

  "listEndpoint": {
    "method": "GET",
    "path": "/v1/api/files/list",
    "defaults": { "page": 1, "limit": 100 },
    "responseFields": [
      "FID", "Name", "TID", "Owner", "FldrID", "FPath", "Location", "OMeta",
      "CrtdOn", "ECSModOn", "Size", "Status", "Type", "LastVersionCrtdOn",
      "RPolicy", "LHold", "Classification"
    ]
  },

  "_downloadResponseNote": "The download endpoint returns the PDF bytes directly (Content-Type: application/pdf), not a JSON envelope. The app does not hard-code that: it reads the response as bytes and classifies it at runtime, checking the Content-Type header and the '%PDF-' file signature. A deployment still answering with the older JSON-with-sasUrl shape therefore keeps working, and the File Download tab shows you which shape actually came back. For the browser to use the real filename instead of 'file-<FID>.pdf', the API must send Content-Disposition AND list it in Access-Control-Expose-Headers — on a cross-origin response JavaScript cannot read any other header.",

  "downloadEndpoint": {
    "method": "GET",
    "path": "/v1/api/file/download/{FID}",
    "defaults": { "FID": "" }
  },

  "fieldsEndpoint": {
    "method": "GET",
    "path": "/v1/api/fields/{TMPLID}",
    "defaults": { "TMPLID": 2 }
  },

  "metadataEndpoint": {
    "method": "POST",
    "path": "/v1/api/file/add-metadata",
    "defaults": { "TID": 2, "FID": "", "TMPLID": "" }
  },

